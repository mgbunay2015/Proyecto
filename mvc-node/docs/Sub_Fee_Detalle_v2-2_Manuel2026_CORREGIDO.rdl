    <DataSet Name="detailedCustomerLedgerEntries">
      <Query>
        <DataSourceName>PowerQuery</DataSourceName>
        <QueryParameters>
          	<QueryParameter Name="FechaInicio">
  <Value>=Parameters!FechaInicio.Value</Value>
</QueryParameter>
<QueryParameter Name="FechaFin">
  <Value>=Parameters!FechaFin.Value</Value>
</QueryParameter>
          <QueryParameter Name="FechaFin">
            <rd:UserDefined>true</rd:UserDefined>
            <Value>=Parameters!FechaInicio.Value</Value>
          </QueryParameter>
          <QueryParameter Name="Ruc">
            <rd:UserDefined>true</rd:UserDefined>
            <Value>=Parameters!RUC.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>{"QueryName":"detailedCustomerLedgerEntries","MashupDocument":"section Section1;\r\nshared detailedCustomerLedgerEntries = let\r\n  Origen = Dynamics365BusinessCentral.ApiContentsWithOptions(\"PRODUCTION-HVQ\", \"Hospital Vozandes Quito\", null, [UseReadOnlyReplica = null, AcceptLanguage = null, Timeout = null, ODataMaxPageSize = null]),\r\n  #\"Navegación 1\" = Origen{[Name = \"Advanced\"]}[Data],\r\n  #\"Navegación 2\" = #\"Navegación 1\"{[Name = \"altiora/localizacion/v2.0\"]}[Data],\r\n  #\"Navegación 3\" = #\"Navegación 2\"{[Name = \"detailedCustomerLedgerEntries\", Signature = \"table\"]}[Data],\r\n  #\"Personalizado agregado\" = let\r\n    Origen = Dynamics365BusinessCentral.ApiContentsWithOptions(\r\n        \"PRODUCTION-HVQ\",\r\n        \"Hospital Vozandes Quito\",\r\n        null,\r\n        [UseReadOnlyReplica = null, AcceptLanguage = null, Timeout = null, ODataMaxPageSize = null]\r\n    ),\r\n\r\n    #\"Navegación 1\" = Origen{[Name = \"Advanced\"]}[Data],\r\n    #\"Navegación 2\" = #\"Navegación 1\"{[Name = \"altiora/localizacion/v2.0\"]}[Data],\r\n\r\n    #\"Navegación 3\" =\r\n        #\"Navegación 2\"{[Name = \"detailedCustomerLedgerEntries\", Signature = \"table\"]}[Data],\r\n\r\n    movimientosClientesALT1 =\r\n        #\"Navegación 2\"{[Name = \"movimientosClientesALT\", Signature = \"table\"]}[Data],\r\n\r\n    #\"Personalizado agregado\" =\r\n        Table.AddColumn(\r\n            #\"Navegación 3\",\r\n            \"DocumentNo_Aplicado_Inicial\",\r\n            each\r\n                let\r\n                    _custLedgerEntryNo = [custLedgerEntryNo],\r\n                    _tablaFiltrada =\r\n                        Table.SelectRows(\r\n                            movimientosClientesALT1,\r\n                            (fila) =&gt; fila[entryNo] = _custLedgerEntryNo\r\n                        ),\r\n                    _valor =\r\n                        if Table.IsEmpty(_tablaFiltrada)\r\n                        then \"\"\r\n                        else Text.PadStart(Text.From(List.Max(_tablaFiltrada[documentNo])), 12, \"0\")\r\n                in\r\n                    _valor,\r\n            type text\r\n        )\r\nin\r\n    #\"Personalizado agregado\",\r\n  #\"Personalizado agregado 1\" = Table.AddColumn(\r\n    #\"Personalizado agregado\",\r\n    \"Comparacion_DocumentNo\",\r\n    each\r\n        if Text.From([DocumentNo_Aplicado_Inicial]) = Text.From([documentNo])\r\n        then \"IGUAL\"\r\n        else \"DIFERENTE\",\r\n    type text\r\n),\r\n  #\"Columnas reordenadas\" = Table.ReorderColumns(#\"Personalizado agregado 1\", {\"amount\", \"custLedgerEntryNo\", \"customerNo\", \"debitAmount\", \"debitAmountLCY\", \"documentType\", \"entryNo\", \"entryType\", \"exchRateAdjmtRegNo\", \"genBusPostingGroup\", \"genProdPostingGroup\", \"initialDocumentType\", \"initialEntryDueDate\", \"initialEntryGlobalDim1\", \"initialEntryGlobalDim2\", \"journalBatchName\", \"ledgerEntryAmount\", \"maxPaymentTolerance\", \"postingDate\", \"postingGroup\", \"reasonCode\", \"remainingPmtDiscPossible\", \"sourceCode\", \"systemCreatedAt\", \"systemCreatedBy\", \"systemId\", \"systemModifiedAt\", \"systemModifiedBy\", \"taxJurisdictionCode\", \"transactionNo\", \"unapplied\", \"unappliedByEntryNo\", \"useTax\", \"userID\", \"vatBusPostingGroup\", \"vatProdPostingGroup\", \"userDef1\", \"userDef2\", \"userDef3\", \"userDef4\", \"userDef5\", \"userDef6\", \"userDef7\", \"userDef8\", \"ETag\", \"documentNo\", \"DocumentNo_Aplicado_Inicial\", \"Comparacion_DocumentNo\"}),\r\n  #\"Columnas quitadas\" = Table.RemoveColumns(#\"Columnas reordenadas\", {\"amountLCY\", \"applicationNo\", \"appliedCustLedgerEntryNo\", \"creditAmount\", \"creditAmountLCY\", \"currencyCode\", \"debitAmount\", \"debitAmountLCY\", \"entryType\", \"exchRateAdjmtRegNo\", \"genBusPostingGroup\", \"genProdPostingGroup\", \"initialEntryGlobalDim1\", \"initialEntryGlobalDim2\", \"journalBatchName\", \"ledgerEntryAmount\", \"maxPaymentTolerance\", \"postingGroup\", \"reasonCode\", \"remainingPmtDiscPossible\", \"sourceCode\", \"systemCreatedAt\", \"systemCreatedBy\", \"systemId\", \"systemModifiedAt\", \"systemModifiedBy\", \"taxJurisdictionCode\", \"unapplied\", \"unappliedByEntryNo\", \"useTax\", \"userID\", \"vatBusPostingGroup\", \"vatProdPostingGroup\", \"userDef4\", \"userDef5\", \"userDef6\", \"userDef7\", \"userDef8\", \"ETag\"})\r\nin\r\n  #\"Columnas quitadas\";\r\n","ConnectionOverrides":[{"Path":"Dynamics365BusinessCentral","Kind":"Dynamics365BusinessCentral","Provider":"DmtsFabric","AuthenticationKind":null,"EnvironmentName":null,"ApiName":null,"ConnectionName":"{\"ClusterId\":\"a1abc3cf-06f3-4161-b408-8a1388debf2f\",\"DatasourceId\":\"31cc04ec-dc88-46bb-8df1-141051414c0e\"}","PrivacyGroup":"None","CredentialDetails":{},"Audience":null,"ConnectionParameters":{}}],"GatewayObjectId":null,"ParameterDefinitions":[]}</CommandText>
      </Query>
