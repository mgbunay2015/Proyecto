            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=(
    Sum(IIf(IsNothing(CDec(Fields!PAID_AMOUNT.Value)), 0, CDec(Fields!PAID_AMOUNT.Value)), "BATCH_Detalle")
    - (
        Sum(IIf(IsNothing(CDec(Fields!PAID_AMOUNT.Value)), 0, CDec(Fields!PAID_AMOUNT.Value)), "BATCH_Detalle")
        - (Sum(IIf(IsNothing(CDec(Fields!VAT_AMOUNT.Value)), 0, CDec(Fields!VAT_AMOUNT.Value)), "BATCH_Detalle"))
      ) * CDec(0.1)
    - Sum(IIf(IsNothing(CDec(Fields!VAT_AMOUNT.Value)), 0, CDec(Fields!VAT_AMOUNT.Value)), "BATCH_Detalle")
    - Sum(IIf(IsNothing(CDec(Fields!remainingAmount.Value)), 0, CDec(Fields!remainingAmount.Value)), "movimientosClientesALT1")
)</Value>
                    <Style>
                      <FontSize>9pt</FontSize>
                      <Format>0.00;(0.00)</Format>
