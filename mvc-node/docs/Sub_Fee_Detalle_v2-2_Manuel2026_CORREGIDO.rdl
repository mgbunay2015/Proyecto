        <CommandText>{"QueryName":"movimientosClientesALT","MashupDocument":"section Section1;\r\nshared movimientosClientesALT = let\r\n  Origen = Dynamics365BusinessCentral.ApiContentsWithOptions(\"PRODUCTION-HVQ\", \"Hospital Vozandes Quito\", null, [UseReadOnlyReplica = null, AcceptLanguage = null, Timeout = null, ODataMaxPageSize = null]),\r\n  #\"Navegación 1\" = Origen{[Name = \"Advanced\"]}[Data],\r\n  #\"Navegación 2\" = #\"Navegación 1\"{[Name = \"altiora/localizacion/v2.0\"]}[Data],\r\n  #\"Navegación 3\" = #\"Navegación 2\"{[Name = \"movimientosClientesALT\", Signature = \"table\"]}[Data],\r\n  #\"Personalizado agregado\" = Table.AddColumn(#\"Navegación 3\", \"DocumentNo_Aplicado_Inicial\", each try\r\n    Table.SelectRows(\r\n        movimientosClientesALT1,\r\n        (x) =&gt; x[entryNo] = [custLedgerEntryNo]\r\n    ){0}[documentNo]\r\notherwise \"\")\r\nin\r\n  #\"Personalizado agregado\";\r\n","ConnectionOverrides":[{"Path":"Dynamics365BusinessCentral","Kind":"Dynamics365BusinessCentral","Provider":"DmtsFabric","AuthenticationKind":null,"EnvironmentName":null,"ApiName":null,"ConnectionName":"{\"ClusterId\":\"a1abc3cf-06f3-4161-b408-8a1388debf2f\",\"DatasourceId\":\"31cc04ec-dc88-46bb-8df1-141051414c0e\"}","PrivacyGroup":"None","CredentialDetails":{},"Audience":null,"ConnectionParameters":{}}],"GatewayObjectId":null,"ParameterDefinitions":[]}</CommandText>
