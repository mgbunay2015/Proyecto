  <DataSets>
    <DataSet Name="BATCH_Detalle">
      <Query>
        <DataSourceName>REPORTS_BI</DataSourceName>
        <QueryParameters>
          <QueryParameter Name=":ID_GENERACION">
            <Value>=Parameters!ID_GENERACION.Value</Value>
          </QueryParameter>
          <QueryParameter Name=":RUC">
            <Value>=Parameters!RUC.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT DISTINCT fb.ID AS ID_GENERACION , fb.CREATED_DATE, fb.START_DATE ,fb.END_DATE, 
fbase.SALES_INVOICE_DATE ,fbe.SALES_INVOICE,  fbe.CLINIC_HISTORY ,fbase.ADMISSION,  fbase.PATIENT ,
fbase.ACCOUNT_NUMBER,   fbe.RUC , 
fbe.DOCTOR_NAME,fbe.RUC|| ' - ' || fbe.DOCTOR_NAME AS RUC_DOCTOR_NAME, fbe.DOCUMENT_TYPE ,fbase.PATIENT_TYPE   , 
fbe.FEE_BATCH_ID , fbe.INITIAL_AMOUNT  , fbe.AMOUNT_TO_PAY ,fbe.BALANCE_AMOUNT , fbe.TOTAL_AMOUNT ,fbe.VAT_AMOUNT ,
fbase.PAID_AMOUNT , fbase.REMAINING_AMOUNT 
FROM FEE_BATCH_ELEMENT fbe INNER JOIN FEE_BATCH fb ON fbe.FEE_BATCH_ID = fb.ID  
INNER JOIN FEE_BASE fbase ON fbe.FEE_BASE_ID =fbase.ID 
INNER JOIN  FEE_BASE_LINE fbl ON fbase.ID = fbl.FEE_BASE_ID 
WHERE fbe.FEE_BATCH_ID = :ID_GENERACION
AND fbe.RUC = :RUC
AND fbe.SELECTED = 1
ORDER BY fbase.SALES_INVOICE_DATE</CommandText>
      </Query>
